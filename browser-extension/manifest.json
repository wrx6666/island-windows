{
  "manifest_version": 3,
  "name": "Island Music Bridge",
  "version": "0.10.1",
  "description": "Передаёт трек Яндекс Музыки/VK в Island: обложка, пауза и переключение треков.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://vk.com/*",
        "https://vk.ru/*",
        "https://music.vk.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://vk.com/*",
        "https://vk.ru/*",
        "https://music.vk.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Island · подключение музыки",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://music.yandex.ru/*",
    "https://music.yandex.com/*",
    "https://vk.com/*",
    "https://vk.ru/*",
    "https://music.vk.com/*"
  ]
}
